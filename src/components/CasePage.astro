---
import Base from '../layouts/Base.astro';
import { projects, type Project } from '../data/projects';
import { useT, paths, type Lang } from '../i18n/ui';

interface Props { project: Project; lang: Lang }
const { project: p, lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const idx = projects.findIndex((x) => x.slug === p.slug);
const nextP = projects[(idx + 1) % projects.length];
const pad = (n: number) => String(n).padStart(2, '0');
const metrics = p.metrics.filter((m) => m.value !== null);
const host = (u: string) => u.replace(/^https?:\/\//, '');

const sections = [
  { id: 'probleme', label: t('case.problem') },
  { id: 'decisions', label: t('case.decisions') },
  ...(metrics.length ? [{ id: 'resultat', label: t('case.outcome') }] : []),
  ...(p.next ? [{ id: 'ensuite', label: t('case.next') }] : []),
];
const num = (id: string) => pad(sections.findIndex((s) => s.id === id) + 1);
---
<Base
  lang={lang}
  title={`${p.title} — ${t('case.kicker')} · Jeff Zara`}
  description={p.lead[lang]}
  altPath={paths.project(other, p.slug)}
>
  <div class="wrap crumbs mono">
    <a href={`${paths.home(lang)}#travaux`}>{t('case.back')}</a>
    <span>N°{pad(idx + 1)} / {pad(projects.length)}</span>
  </div>

  <header class="wrap top">
    <p class="mono accent kicker">{t('case.kicker')} — {p.kind[lang]}</p>
    <h1 class="display title">{p.title}</h1>
    <p class="lead">{p.lead[lang]}</p>
    <dl class="meta mono">
      <div><dt class="muted">{t('case.role')}</dt><dd>{p.role[lang]}</dd></div>
      {p.duration && <div><dt class="muted">{t('case.duration')}</dt><dd>{p.duration[lang]}</dd></div>}
      <div><dt class="muted">Stack</dt><dd>{p.stack.join(', ')}</dd></div>
      {p.live && <div><dt class="muted">{t('case.live')}</dt><dd><a href={p.live} rel="noopener" target="_blank">{host(p.live)} ↗</a></dd></div>}
      {p.repo && <div><dt class="muted">{t('case.code')}</dt><dd><a href={p.repo} rel="noopener" target="_blank">{host(p.repo)} ↗</a></dd></div>}
    </dl>
  </header>

  <figure class="wrap media">
    <div class="shot hero-shot">
      {p.image ? <img src={p.image} alt={p.imageAlt[lang]} width="1440" height="720" /> : <span>[{p.imageAlt[lang]}]</span>}
    </div>
  </figure>

  <div class="wrap body">
    <nav class="toc mono" aria-label={t('case.toc')}>
      {sections.map((s, i) => <a href={`#${s.id}`}>{pad(i + 1)} {s.label}</a>)}
    </nav>

    <div class="content">
      <section id="probleme" class="prose">
        <h2 class="display h">{num('probleme')} — {t('case.problem')}</h2>
        {p.problem.map((para) => <p>{para[lang]}</p>)}
      </section>

      <section id="decisions">
        <div class="dhead rule-heavy">
          <h2 class="display h">{num('decisions')} — {t('case.decisions')}</h2>
          <span class="mono">{t('case.decSub')}</span>
        </div>
        {p.decisions.map((d, i) => (
          <article class="dec">
            <span class="mono">D{i + 1}</span>
            <div>
              <h3>{d.title[lang]}</h3>
              <p class="muted">{d.context[lang]}</p>
            </div>
            <div>
              <p class="mono accent lbl">{t('case.choice')}</p>
              <p>{d.choice[lang]}</p>
            </div>
            <div>
              <p class="mono muted lbl">{t('case.cost')}</p>
              <p>{d.cost[lang]}</p>
            </div>
          </article>
        ))}
      </section>

      {metrics.length > 0 && (
        <section id="resultat">
          <h2 class="display h">{num('resultat')} — {t('case.outcome')}</h2>
          <dl class="metrics mono">
            {metrics.map((m) => (<><dt>{m.label[lang]}</dt><dd>{m.value}</dd></>))}
          </dl>
        </section>
      )}

      {p.next && (
        <section id="ensuite" class="prose">
          <h2 class="display h">{num('ensuite')} — {t('case.next')}</h2>
          <p>{p.next[lang]}</p>
        </section>
      )}
    </div>
  </div>

  <nav class="wrap pager mono" aria-label="Pagination">
    <a href={`${paths.home(lang)}#travaux`}>{t('case.all')}</a>
    <a href={paths.project(lang, nextP.slug)}>N°{pad(((idx + 1) % projects.length) + 1)} {nextP.title} →</a>
  </nav>
</Base>

<style>
  .crumbs { display: flex; justify-content: space-between; padding-top: 20px; padding-bottom: 20px; }
  .top { padding-top: clamp(32px, 6vw, 64px); padding-bottom: 48px; }
  .kicker { text-transform: uppercase; margin-bottom: 20px; }
  .title { font-size: clamp(6rem, 15vw, 12.5rem); font-weight: 900; font-stretch: 62%; line-height: 0.82; letter-spacing: -0.02em; }
  .lead { margin-top: 32px; max-width: 820px; font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.2; }
  .meta {
    margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
  }
  .meta > div { padding: 16px; border-left: 1px solid var(--faint); }
  .meta > div:first-child { border-left: 0; padding-left: 0; }
  .meta dd { margin-top: 6px; overflow-wrap: anywhere; }

  .media { margin: 0 auto; padding-bottom: 72px; }
  .hero-shot { aspect-ratio: 2 / 1; }

  .body { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 64px; padding-bottom: 80px; }
  .toc { position: sticky; top: 96px; align-self: start; display: flex; flex-direction: column; line-height: 2.2; }
  .toc a { text-decoration: none; }
  .content { display: flex; flex-direction: column; gap: 80px; min-width: 0; }
  .h { font-size: clamp(2rem, 3.6vw, 2.75rem); margin-bottom: 20px; }
  .prose { max-width: 760px; }
  .prose p { font-size: 1.25rem; line-height: 1.55; }
  .prose p + p { margin-top: 18px; }

  .dhead { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; padding-bottom: 14px; }
  .dhead .h { margin-bottom: 0; }
  .dec { display: grid; grid-template-columns: 56px repeat(3, minmax(0, 1fr)); gap: 32px; padding: 32px 0; border-bottom: 1px solid var(--ink); font-size: 1rem; line-height: 1.5; }
  .dec h3 { font-size: 1.625rem; line-height: 1.1; margin-bottom: 12px; }
  .lbl { font-size: 0.75rem; text-transform: uppercase; margin-bottom: 8px; }

  .metrics { display: grid; grid-template-columns: 1fr auto; border-top: 1px solid var(--ink); font-size: 0.875rem; max-width: 640px; }
  .metrics dt, .metrics dd { padding: 14px 0; border-bottom: 1px solid var(--faint); }

  .pager { display: flex; justify-content: space-between; gap: 16px; border-top: 3px solid var(--ink); padding-top: 32px; padding-bottom: 32px; }

  @media (max-width: 980px) {
    .body { grid-template-columns: 1fr; gap: 40px; }
    .toc { display: none; }
    .dec { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 600px) {
    .meta > div { border-left: 0; padding-left: 0; }
    .media { padding-bottom: 48px; }
  }
</style>
